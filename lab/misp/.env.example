# WAM lab MISP - copy to lab/misp/.env (gitignored). bootstrap.sh does this on
# its first run and fills ADMIN_PASSWORD / ADMIN_KEY with random values; it
# never prints them. Everything else can stay at the defaults.

# Public URL of this MISP. Host port 8445 (8443 = 4.14 dashboard, 8444 = 5.0).
BASE_URL=https://localhost:8445

# Site admin (login at BASE_URL). The org is renamed to ADMIN_ORG on first start.
ADMIN_EMAIL=admin@admin.test
ADMIN_ORG=WAM-LAB
# Filled in by bootstrap.sh (random). Leave empty in the example.
ADMIN_PASSWORD=
# 40 alphanumeric characters: MISP's auth key format. Filled in by bootstrap.sh.
ADMIN_KEY=

# Internal service credentials (lab only, not reachable from the host).
MYSQL_USER=misp
MYSQL_PASSWORD=example
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=misp
REDIS_PASSWORD=redispassword

TZ=UTC
